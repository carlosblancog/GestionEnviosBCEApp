<mvc:View controllerName="zbce.envios.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    displayBlock="true">

    <Page id="detailPage" showNavButton="true" navButtonPress=".onNavBack" title="{i18n>tituloDetalle}">

        <content>
            <uxap:ObjectPageLayout id="objectPageLayout" alwaysShowContentHeader="false" preserveHeaderStateOnScroll="false">

                <uxap:headerTitle>
                    <uxap:ObjectPageDynamicHeaderTitle>
                        <uxap:actions>
                            <Button
                                text="{i18n>btnVerInforme}"
                                icon="sap-icon://table-view"
                                type="Emphasized"
                                press=".onVerInforme"/>
                        </uxap:actions>
                        <uxap:heading>
                            <VBox>
                                <HBox alignItems="Center">
                                    <Text text="{i18n>lblClave}:" class="claveEtiqueta sapUiTinyMarginEnd"/>
                                    <Title id="objectTitle" text="{Clave}" level="H2"/>
                                </HBox>
                                <Label text="{TipoMensaje}" class="sapUiTinyMarginTop"/>
                            </VBox>
                        </uxap:heading>
                        <uxap:snappedHeading>
                            <VBox>
                                <HBox alignItems="Center">
                                    <Text text="{i18n>lblClave}:" class="claveEtiqueta sapUiTinyMarginEnd"/>
                                    <Title text="{Clave}" level="H3"/>
                                </HBox>
                                <Label text="{TipoMensaje}"/>
                            </VBox>
                        </uxap:snappedHeading>
                    </uxap:ObjectPageDynamicHeaderTitle>
                </uxap:headerTitle>

                <uxap:headerContent>
                    <HBox class="sapUiSmallMarginEnd sapUiSmallMarginBottom" alignItems="Center" justifyContent="SpaceAround">

                        <!-- Icono + Fechas -->
                        <HBox>
                            <VBox class="sapUiLargeMarginEnd" justifyContent="Center" alignItems="Center">
                                <core:Icon
                                    src="sap-icon://outbox"
                                    size="3rem"
                                    color="{path: 'Estado', formatter: '.formatter.estadoColor'}"/>
                            </VBox>
                            <VBox class="sapUiLargeMarginEnd">
                                <Title text="{i18n>lblFechas}" class="sapUiSmallMarginBottom"/>
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <core:Icon src="sap-icon://outgoing-call" size="1.3rem" color="#0070F2" class="sapUiTinyMarginEnd" tooltip="{i18n>colFechaEnvio}"/>
                                    <Text text="{path: 'FechaEnvio', formatter: '.formatter.formatUtcToLocal'}" class="headerDateText"/>
                                </HBox>
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <core:Icon src="sap-icon://inbox" size="1.3rem" color="#0070F2" class="sapUiTinyMarginEnd" tooltip="{i18n>colFechaUltConf}"/>
                                    <Text text="{path: 'FechaUltConf', formatter: '.formatter.textoFechaResp'}" class="headerDateText"/>
                                </HBox>
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <core:Icon src="sap-icon://repost" size="1.3rem" color="#E9730C" class="sapUiTinyMarginEnd" tooltip="{i18n>colFechaReenvio}"/>
                                    <Text text="{path: 'detailModel>/ultimoReenvio', formatter: '.formatter.textoFechaReenvio'}" class="headerDateText"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- Estado -->
                        <VBox class="sapUiLargeMarginEnd">
                            <Title text="{i18n>lblEstado}" class="sapUiSmallMarginBottom"/>
                            <ObjectStatus
                                class="sapMObjectStatusLarge"
                                text="{path: 'Estado', formatter: '.formatter.estadoText'}"
                                state="{path: 'Estado', formatter: '.formatter.estadoState'}"
                                icon="{path: 'Estado', formatter: '.formatter.estadoIcon'}"/>
                        </VBox>

                        <!-- Pendiente -->
                        <VBox class="sapUiLargeMarginEnd">
                            <Title text="{i18n>lblPendienteResp}" class="sapUiSmallMarginBottom"/>
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://synchronize" class="rotating sapUiTinyMarginEnd" visible="{PendienteResp}" color="#E9730C" size="1.2rem"/>
                                <core:Icon src="sap-icon://status-completed" class="sapUiTinyMarginEnd" visible="{= !${PendienteResp}}" color="#107E3E" size="1.2rem"/>
                                <ObjectStatus
                                    class="sapMObjectStatusLarge"
                                    text="{= ${PendienteResp} ? ${i18n>pendienteSi} : ${i18n>pendienteNo} }"
                                    state="{= ${PendienteResp} ? 'Warning' : 'Success' }"/>
                            </HBox>
                        </VBox>

                        <!-- Source -->
                        <VBox>
                            <Title text="{i18n>lblSource}" class="sapUiSmallMarginBottom"/>
                            <ObjectStatus class="sapMObjectStatusLarge" text="{Source}" state="Information"/>
                        </VBox>

                    </HBox>
                </uxap:headerContent>

                <uxap:sections>
                    <uxap:ObjectPageSection id="sectionComunicaciones" title="{i18n>tituloComunicaciones}" showTitle="true">
                        <uxap:subSections>
                            <uxap:ObjectPageSubSection id="subSectionComunicaciones" showTitle="false">
                                <uxap:blocks>
                                    <Table
                                        id="comunicacionesTable"
                                        items="{detailModel>/comunicaciones}"
                                        noDataText="{i18n>sinDatos}"
                                        growing="false">

                                        <columns>
                                            <Column width="16rem">
                                                <Text text="{i18n>colCorrelationId}"/>
                                            </Column>
                                            <Column width="11rem" minScreenWidth="Tablet" demandPopin="true">
                                                <Text text="{i18n>colFechaEnvio}"/>
                                            </Column>
                                            <Column width="11rem" minScreenWidth="Tablet" demandPopin="true">
                                                <Text text="{i18n>colFechaRespuesta}"/>
                                            </Column>
                                            <Column width="6rem" hAlign="Center">
                                                <Text text="{i18n>colNumEnvio}"/>
                                            </Column>
                                            <Column width="7rem" hAlign="Center">
                                                <Text text="{i18n>colSeveridad}"/>
                                            </Column>
                                            <Column width="9rem" hAlign="Center">
                                                <Text text=""/>
                                            </Column>
                                        </columns>

                                        <items>
                                            <ColumnListItem type="Inactive">
                                                <cells>
                                                    <Text text="{detailModel>CorrelationId}"/>
                                                    <Text text="{path: 'detailModel>FechaEnvio', formatter: '.formatter.formatUtcToLocal'}"/>
                                                    <ObjectStatus
                                                        text="{path: 'detailModel>FechaRespuesta', formatter: '.formatter.textoFechaResp'}"
                                                        state="{path: 'detailModel>FechaRespuesta', formatter: '.formatter.fechaRespState'}"/>
                                                    <Text text="{detailModel>NumEnvio}"/>
                                                    <HBox alignItems="Center" justifyContent="Center">
                                                        <core:Icon
                                                            src="{path: 'detailModel>SeverityCodeMax', formatter: '.formatter.severityIcon'}"
                                                            size="1.2rem"
                                                            color="{path: 'detailModel>SeverityCodeMax', formatter: '.formatter.severityColor'}"
                                                            tooltip="{path: 'detailModel>SeverityCodeMax', formatter: '.formatter.severityText'}"/>
                                                    </HBox>
                                                    <Button
                                                        text="{i18n>btnVerMensajes}"
                                                        icon="sap-icon://message-popup"
                                                        type="Transparent"
                                                        press=".onVerMensajes"/>
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </uxap:blocks>
                            </uxap:ObjectPageSubSection>
                        </uxap:subSections>
                    </uxap:ObjectPageSection>
                </uxap:sections>

            </uxap:ObjectPageLayout>
        </content>
    </Page>
</mvc:View>
