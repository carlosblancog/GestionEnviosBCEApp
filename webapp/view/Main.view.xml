<mvc:View
    controllerName="zbce.envios.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page title="{i18n>titleHistorial}" showNavButton="false">
        <headerContent>
            <Button
                text="{i18n>btnNuevoEnvio}"
                type="Emphasized"
                press=".onNuevoEnvio"/>
        </headerContent>

        <content>
            <Table
                id="tablaCabeceras"
                items="{
                    path: '/EnviosCabeceraSet',
                    sorter: { path: 'FechaEnvio', descending: true }
                }"
                growing="true"
                growingThreshold="20"
                noDataText="{i18n>noEnvios}">

                <headerToolbar>
                    <Toolbar>
                        <Title text="{i18n>titleHistorial}"/>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://refresh" press=".onRefresh" tooltip="{i18n>btnRefresh}"/>
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column><Text text="{i18n>colClave}"/></Column>
                    <Column><Text text="{i18n>colEstado}"/></Column>
                    <Column><Text text="{i18n>colFechaEnvio}"/></Column>
                    <Column><Text text="{i18n>colTipoMensaje}"/></Column>
                    <Column><Text text="{i18n>colPendiente}"/></Column>
                </columns>

                <items>
                    <ColumnListItem
                        type="Navigation"
                        press=".onEnvioPress">
                        <cells>
                            <Text text="{Clave}"/>
                            <ObjectStatus
                                text="{Estado}"
                                state="{
                                    path: 'Estado',
                                    formatter: '.formatEstadoState'
                                }"/>
                            <Text text="{FechaEnvio}"/>
                            <Text text="{TipoMensaje}"/>
                            <core:Icon
                                src="sap-icon://message-warning"
                                color="Critical"
                                visible="{PendienteResp}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
