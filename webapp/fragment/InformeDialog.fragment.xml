<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="informeDialog"
        title="{informeModel>/titulo}"
        contentWidth="60rem"
        contentHeight="40rem"
        resizable="true"
        draggable="true"
        class="sapUiContentPadding">

        <content>
            <Table
                id="informeTable"
                items="{informeModel>/lineas}"
                noDataText="{i18n>sinDatosInforme}"
                growing="true"
                growingThreshold="50"
                sticky="ColumnHeaders">

                <columns>
                    <Column width="9rem">
                        <Text text="{i18n>colEpigrafe}"/>
                    </Column>
                    <Column width="10rem">
                        <Text text="{i18n>colParentLvl1}"/>
                    </Column>
                    <Column width="10rem">
                        <Text text="{i18n>colParentLvl2}"/>
                    </Column>
                    <Column hAlign="End">
                        <Text text="{i18n>colBalance}"/>
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Inactive">
                        <cells>
                            <Text text="{informeModel>Epigrafe}"/>
                            <Text text="{informeModel>ParentLvl1}"/>
                            <Text text="{informeModel>ParentLvl2}"/>
                            <Text text="{informeModel>Balance}"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        <beginButton>
            <Button
                text="{i18n>btnCerrar}"
                icon="sap-icon://decline"
                press=".onCloseInformeDialog"/>
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
