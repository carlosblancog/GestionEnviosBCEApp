<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="mensajesDialog"
        title="{mensajesModel>/titulo}"
        contentWidth="55rem"
        resizable="true"
        draggable="true"
        class="sapUiContentPadding">

        <content>
            <Table
                id="mensajesTable"
                items="{mensajesModel>/mensajes}"
                noDataText="{i18n>sinMensajes}"
                growing="false">

                <columns>
                    <Column width="9rem">
                        <Text text="{i18n>colCodigoMensaje}"/>
                    </Column>
                    <Column width="5rem" hAlign="Center">
                        <Text text="{i18n>colOrden}"/>
                    </Column>
                    <Column width="7rem">
                        <Text text="{i18n>colTypeid}"/>
                    </Column>
                    <Column width="7rem" hAlign="Center">
                        <Text text="{i18n>colSeveridad}"/>
                    </Column>
                    <Column>
                        <Text text="{i18n>colNote}"/>
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Inactive">
                        <cells>
                            <Text text="{mensajesModel>CodigoMensaje}"/>
                            <Text text="{mensajesModel>Orden}"/>
                            <Text text="{mensajesModel>TypeId}"/>
                            <HBox alignItems="Center" justifyContent="Center">
                                <core:Icon
                                    src="{path: 'mensajesModel>SeverityCode', formatter: '.formatter.severityIcon'}"
                                    size="1.2rem"
                                    color="{path: 'mensajesModel>SeverityCode', formatter: '.formatter.severityColor'}"
                                    tooltip="{path: 'mensajesModel>SeverityCode', formatter: '.formatter.severityText'}"/>
                            </HBox>
                            <Text text="{mensajesModel>Note}" wrapping="true"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        <beginButton>
            <Button
                text="{i18n>btnCerrar}"
                icon="sap-icon://decline"
                press=".onCloseMensajesDialog"/>
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
